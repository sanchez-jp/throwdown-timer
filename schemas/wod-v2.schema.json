{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanchez-jp.github.io/throwdown-timer/schemas/wod-v2.schema.json",
  "title": "Throwdown Timer WOD Interpretation",
  "description": "Version 2 semantic workout model. Timer plan reuses the stable v1 timer block contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "workout",
    "timer",
    "interpretation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "workout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "description",
        "movements",
        "structure"
      ],
      "properties": {
        "format": {
          "enum": [
            "amrap",
            "for_time",
            "emom",
            "e2mom",
            "tabata",
            "intervals",
            "rounds_for_time",
            "chipper",
            "ladder",
            "death_by",
            "strength_plus_wod",
            "custom"
          ]
        },
        "description": {
          "type": "string"
        },
        "movements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "prescription",
              "load",
              "notes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "prescription": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "load": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "structure": {
          "$ref": "#/$defs/structureNode"
        },
        "legacyFormat": {
          "type": "string",
          "minLength": 1,
          "description": "Original v1 format retained when its semantic structure cannot be reconstructed safely."
        }
      }
    },
    "timer": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "wod-v1.schema.json#/$defs/plan"
        }
      ]
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issues"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "needs_review",
            "invalid"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "wod-v1.schema.json#/$defs/issue"
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/structureNode"
      }
    },
    "structureNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/movementNode"
        },
        {
          "$ref": "#/$defs/sequenceNode"
        },
        {
          "$ref": "#/$defs/roundsNode"
        },
        {
          "$ref": "#/$defs/chipperNode"
        },
        {
          "$ref": "#/$defs/ladderNode"
        },
        {
          "$ref": "#/$defs/sectionsNode"
        }
      ]
    },
    "movementNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "movementId"
      ],
      "properties": {
        "type": {
          "const": "movement"
        },
        "movementId": {
          "type": "string",
          "minLength": 1
        },
        "prescription": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional occurrence-specific override; otherwise use the catalogue prescription."
        }
      }
    },
    "sequenceNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "sequence"
        },
        "items": {
          "$ref": "#/$defs/nonEmptyItems"
        }
      }
    },
    "roundsNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "count",
        "items"
      ],
      "properties": {
        "type": {
          "const": "rounds"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "items": {
          "$ref": "#/$defs/nonEmptyItems"
        }
      }
    },
    "chipperNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "chipper"
        },
        "items": {
          "$ref": "#/$defs/nonEmptyItems"
        }
      }
    },
    "ladderNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "direction",
        "steps"
      ],
      "properties": {
        "type": {
          "const": "ladder"
        },
        "direction": {
          "enum": [
            "ascending",
            "descending",
            "alternating",
            "custom"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "items"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "items": {
                "$ref": "#/$defs/nonEmptyItems"
              }
            }
          }
        }
      }
    },
    "sectionsNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sections"
      ],
      "properties": {
        "type": {
          "const": "sections"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "structure"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "structure": {
                "$ref": "#/$defs/structureNode"
              }
            }
          }
        }
      }
    }
  }
}
